# Production environment for the replacement MIT Sailing Docker stack.
# Copy to `.env.production` on the production host and fill in real values.
# WordPress uses a separate compose stack and tunnel; do not put WordPress
# settings here. NEVER commit the filled file.

# ───── Runtime shape ─────
APP_ENV=production
MAIL_TRANSPORT=smtp

# Preview mode until go-live: noindex + public banner pointing members to
# sailing.mit.edu. Set to `no` when mitsailing.com becomes the official site.
STAGING_BANNER=yes

# ───── Better Auth ─────
# Generate a fresh secret for production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Next.js self-hosting ─────
# Required because blue and green web containers overlap during deploys.
# Generate once and keep stable across releases:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-32+char-random-string-111111111

# ───── Internal revalidation ─────
NEWSLETTER_REVALIDATE_SECRET=replace-with-a-32+char-random-string-222222222

# ───── Health checks ─────
# Required for protected `/api/health/ready`; share only with uptime monitors.
HEALTHCHECK_SECRET=replace-with-a-32+char-random-string-333333333

# ───── Public URL ─────
NEXT_PUBLIC_APP_URL=https://mitsailing.com

# ───── In-stack data services ─────
# Hosts are Docker Compose service names resolved on the MIT Sailing stack
# network. No host Postgres/Redis install or host port binding is required.
POSTGRES_DB=mitsailing_prod
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE-ME-STRONG-PASSWORD@postgres:5432/mitsailing_prod?schema=public
REDIS_URL=redis://redis:6379

# ───── PgHero database dashboard ─────
# PgHero is served at https://pghero.mitsailing.com with PgHero basic auth.
# Use a dedicated `pghero` Postgres role, not the app superuser URL; see
# docs/deploy.md for setup.
PGHERO_DATABASE_URL=postgresql://pghero:CHANGE-ME-PGHERO-PASSWORD@postgres:5432/mitsailing_prod
PGHERO_USERNAME=pghero-admin
PGHERO_PASSWORD=CHANGE-ME-PGHERO-HTTP-PASSWORD

# ───── CMS media uploads ─────
# Cloudflare routes `/cms-media/uploads/*` to tusd and `/cms-media/*` to media
# nginx on the same public hostname, so uploads/media remain same-origin.
MEDIA_UPLOAD_BASE_URL=https://mitsailing.com
MEDIA_PUBLIC_BASE_URL=https://mitsailing.com
MEDIA_STORAGE_ROOT=/var/lib/mitsailing/cms-media
CMS_MEDIA_ROOT=/var/lib/mitsailing/cms-media
MEDIA_UPLOAD_SHARED_SECRET=replace-with-a-32+char-random-string-444444444
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_UPLOAD_CORS_ALLOW_ORIGIN=https://mitsailing.com
TUSD_HOOKS_HTTP_URL=https://mitsailing.com/api/internal/cms-media/tusd/hooks

# ───── Email (Mailpit capture with Mailpit-owned Resend relay) ─────
SMTP_URL=smtp://mailpit:1025
MAILPIT_API_URL=http://mailpit:8025
RESEND_API_KEY=re_replace_with_real_key
RESEND_WEBHOOK_SECRET=whsec_replace_with_real_secret
EMAIL_FROM="MIT Sailing <noreply@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com
NEWSLETTER_WORKER_CONCURRENCY=2

# Mailpit UI basic-auth credentials for https://mitsailing.com/mail/.
# Generate the bcrypt hash once with:
#   docker run --rm httpd:alpine htpasswd -nbB mail-admin 'YOUR-STRONG-PASSWORD'
MAILPIT_UI_AUTH='mail-admin:$2y$05$replaceWithRealBcryptHash..........................'
MAILPIT_MAX_MESSAGES=10000
MAILPIT_MAX_AGE=30d
# Mailpit relays only matching recipients to Resend SMTP and keeps all mail
# captured locally. The Go-regex pattern includes ak@callred.com plus aliases
# and Resend's documented test recipients; suppressed@resend.dev intentionally
# has no plus alias because Resend does not support labels for that test
# address.
MAILPIT_SMTP_RELAY_HOST=smtp.resend.com
MAILPIT_SMTP_RELAY_PORT=587
MAILPIT_SMTP_RELAY_STARTTLS=true
MAILPIT_SMTP_RELAY_AUTH=plain
MAILPIT_SMTP_RELAY_USERNAME=resend
MAILPIT_SMTP_RELAY_MATCHING=(?i)^(ak(\+[^@]+)?@callred\.com|delivered(\+[^@]+)?@resend\.dev|bounced(\+[^@]+)?@resend\.dev|complained(\+[^@]+)?@resend\.dev|suppressed@resend\.dev)\z

# ───── Stripe event payments ─────
# Prefer a restricted API key with the minimum required Checkout/webhook
# permissions over a full secret key.
STRIPE_SECRET_KEY=rk_live_replace_with_restricted_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
# Optional. Required only for the profile billing portal action.
STRIPE_MEMBERSHIP_BILLING_PORTAL_CONFIGURATION_ID=bpc_replace_with_real_configuration_id

# ───── Cloudflare Tunnel ─────
# This token belongs to the MIT Sailing app tunnel only. WordPress has a
# separate tunnel and remains untouched.
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-with-real-token

# ───── Observability ─────
NEXT_PUBLIC_LOGGING_LEVEL=info

# Sentry — set `NEXT_PUBLIC_SENTRY_DSN` and `SENTRY_AUTH_TOKEN` on the GitHub
# `production` environment (see docs/deploy.md). deploy.yml passes the DSN as a
# Docker build-arg and the auth token as a BuildKit secret; neither is read from
# this file during `next build`.
# NEXT_PUBLIC_SENTRY_DSN=

# ───── Image (deploy-owned) ─────
# APP_IMAGE and DEPLOYMENT_VERSION are written to `.env.image` by deploy
# automation. Do not set APP_IMAGE here; stale floating tags can recreate a
# host from the wrong image.
