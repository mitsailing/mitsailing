# Production app-host environment. Copy to `.env.production.app-host` on each
# headless app host and fill in real values. `.env.production` is also accepted
# during migration from the legacy single-host stack. NEVER commit filled files.
#
# The data/media server uses `.env.production.data`; this file is for the
# stateless blue/green app hosts.

# ───── Runtime shape ─────
APP_ENV=production
HOST_COLOR=
HOST_TRAFFIC_ENABLED=false
# compose.prod.app-host.yaml mounts .deploy/traffic-enabled here so deploy
# automation can drain/promote a host without restarting the app container.
HOST_TRAFFIC_STATE_FILE=/run/mitsailing/traffic-enabled
MAIL_TRANSPORT=resend

# ───── Better Auth ─────
# Generate a fresh secret for production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Next.js self-hosting ─────
# Required when blue and green app hosts can overlap during a deploy.
# Generate once and keep the same value on both app hosts:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-32+char-random-string-111111111

# ───── Internal revalidation ─────
NEWSLETTER_REVALIDATE_SECRET=replace-with-a-32+char-random-string-222222222

# ───── Health checks ─────
# Required for protected `/api/health/ready`; share only with uptime monitors.
HEALTHCHECK_SECRET=replace-with-a-32+char-random-string-333333333

# ───── Public URL ─────
NEXT_PUBLIC_APP_URL=https://mitsailing.com

# ───── External Docker data/media server ─────
# These point to the private IP or private DNS name of the data/media server.
DATABASE_URL=postgresql://mitsailing:CHANGE-ME-STRONG-PASSWORD@DATA_SERVER_PRIVATE_IP:5432/mitsailing_prod?schema=public
REDIS_URL=redis://DATA_SERVER_PRIVATE_IP:6379

# ───── CMS media uploads ─────
# Upload bytes go to the Docker upload service on the data/media server, not to
# the blue/green app hosts. MEDIA_STORAGE_ROOT is the in-container path used by
# data/media server services and workers.
MEDIA_UPLOAD_BASE_URL=https://uploads.mitsailing.com
MEDIA_PUBLIC_BASE_URL=https://media.mitsailing.com
MEDIA_STORAGE_ROOT=/srv/mitsailing-data/cms-media
MEDIA_UPLOAD_SHARED_SECRET=replace-with-a-32+char-random-string-444444444

# Legacy local media root kept for old local-storage rows and local tooling.
CMS_MEDIA_ROOT=/var/lib/mitsailing/cms-media

# ───── Email (Resend) ─────
RESEND_API_KEY=re_replace_with_real_key
RESEND_WEBHOOK_SECRET=whsec_replace_with_real_secret
EMAIL_FROM="MIT Sailing <noreply@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com
NEWSLETTER_WORKER_CONCURRENCY=2

# ───── Cloudflare Tunnel ─────
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-with-real-token

# ───── Observability ─────
NEXT_PUBLIC_LOGGING_LEVEL=info

# Sentry — set `NEXT_PUBLIC_SENTRY_DSN` and `SENTRY_AUTH_TOKEN` on the GitHub
# `production` environment (see docs/deploy.md). They are passed as Docker
# build-args in deploy.yml, not read from this file during `next build`.
# NEXT_PUBLIC_SENTRY_DSN=

# ───── Image (deploy-owned) ─────
# APP_IMAGE and DEPLOYMENT_VERSION are written to `.env.image` by deploy
# automation. Do not set APP_IMAGE here; stale floating tags can recreate a
# host from the wrong image.
