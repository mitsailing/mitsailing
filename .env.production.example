# Production environment. Copy to `.env.production` on the production host
# and fill in real values. NEVER commit the filled file.
#
# Differences from staging: MAIL_TRANSPORT=resend (real delivery), no Mailpit
# container in the stack (see compose.prod.yaml), stricter logging level.

# ───── Runtime shape ─────
APP_ENV=production
MAIL_TRANSPORT=resend

# ───── Better Auth ─────
# Generate a fresh secret for production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Internal revalidation ─────
# Generate a fresh bearer token for newsletter archive cache refreshes.
NEWSLETTER_REVALIDATE_SECRET=replace-with-a-32+char-random-string-111111111

# ───── Health checks ─────
# Required for protected `/api/health/ready`; share only with uptime monitors.
HEALTHCHECK_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Public URL ─────
NEXT_PUBLIC_APP_URL=https://mitsailing.com

# ───── Database (Docker Compose service `postgres`; see compose.yaml) ─────
# Production defaults to database name `mitsailing_prod` (compose.prod.yaml).
# If your production data directory was first initialized with `dev_db`, set
# POSTGRES_DB=dev_db and point DATABASE_URL at dev_db until you migrate.
POSTGRES_DB=mitsailing_prod
DATABASE_URL=postgresql://postgres:CHANGE-ME-STRONG-PASSWORD@postgres:5432/mitsailing_prod?sslmode=disable
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ───── Redis (BullMQ; Compose service `redis`) ─────
REDIS_URL=redis://redis:6379

# ───── Production data root ─────
# Production Compose bind-mounts host directories below `/srv/mitsailing-data`
# for Postgres, Redis, and CMS media. Keep that root outside Docker-managed
# volumes so `docker compose down -v` cannot delete durable state.
#
# Required host paths:
#   /srv/mitsailing-data/postgres
#   /srv/mitsailing-data/redis
#   /srv/mitsailing-data/cms-media

# ───── CMS media uploads ─────
# App and worker mount `/srv/mitsailing-data/cms-media` at this literal
# in-container path. Include the host directory in backups.
CMS_MEDIA_ROOT=/var/lib/mitsailing/cms-media

# ───── Email (Resend) ─────
RESEND_API_KEY=re_replace_with_real_key
RESEND_WEBHOOK_SECRET=whsec_replace_with_real_secret
EMAIL_FROM="MIT Sailing <noreply@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com
NEWSLETTER_WORKER_CONCURRENCY=2

# ───── Cloudflare Tunnel ─────
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-with-real-token

# ───── Observability ─────
NEXT_PUBLIC_LOGGING_LEVEL=info

# Sentry — set `NEXT_PUBLIC_SENTRY_DSN` and `SENTRY_AUTH_TOKEN` on the GitHub
# `production` environment (see docs/deploy.md). They are passed as Docker
# build-args in deploy.yml, not read from this file during `next build`.
# Optional operator copy below; omit if CI already supplies the DSN.
# NEXT_PUBLIC_SENTRY_DSN=

# ───── Image (overwritten on each deploy by deploy.sh → .env.image) ─────
# CI publishes `latest` and `sha-<12 hex chars>`. Local defaults are fine.
APP_IMAGE=ghcr.io/mitsailing/mitsailing:latest

# ───── Optional: Next.js self-hosting (multi-instance / rolling deploys) ─────
# Set the same value on every `app` container to avoid client/build skew.
# DEPLOYMENT_VERSION=sha-abc123def456
#
# Before running more than one `app` replica (or overlapping rolling deploys),
# set a shared AES key (https://nextjs.org/docs/app/guides/data-security):
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
