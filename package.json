{
  "name": "mitsailing",
  "version": "0.0.0",
  "private": true,
  "description": "MIT Sailing — pavilion and programs on the Charles (https://mitsailing.com).",
  "homepage": "https://mitsailing.com",
  "bugs": {
    "url": "https://github.com/mitsailing/mitsailing/issues"
  },
  "license": "UNLICENSED",
  "author": "MIT Sailing (https://mitsailing.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsailing/mitsailing.git"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev:app": "next dev",
    "db:up": "node scripts/prepare-local-media-storage.cjs && docker compose up -d postgres mailpit redis tusd media",
    "db:down": "docker compose down",
    "db:test:up": "npm run db:up",
    "db:test:down": "npm run db:down",
    "db:wait": "node scripts/db-wait.mjs",
    "dev": "run-s db:up db:wait db:migrate dev:app",
    "build:next": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node24 --outfile=worker.mjs --format=esm --packages=external --alias:server-only=./src/worker/serverOnlyShim.ts --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "worker:dev": "dotenv -c -- run-s build:worker worker:run",
    "worker:run": "node scripts/run-worker-local.cjs",
    "build-local": "node scripts/build-local.mjs",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "next typegen && tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl -o invalidKeys missingKeys undefined -i \"AuthErrors.*\" \"AuthEmails.*\"",
    "commit": "commit",
    "test": "cross-env TZ=UTC vitest run --project unit --project component",
    "test:coverage": "cross-env TZ=UTC vitest run --coverage --project unit --project component && node scripts/check-critical-coverage.mjs",
    "test:mit-weather-contract": "cross-env RUN_MIT_WEATHER_CONTRACT=1 vitest run --project contract",
    "test:integration": "run-s db:test:up db:wait db:migrate:test && cross-env RUN_DATABASE_TESTS=1 npm run test && npm run db:test:down",
    "e2e:preflight": "run-s e2e:killport e2e:db:up db:wait db:migrate:test e2e:seed",
    "e2e:killport": "node scripts/e2e-killport.cjs",
    "e2e:db:up": "node scripts/e2e-compose-up.cjs",
    "e2e:seed": "node scripts/seed-test-db.mjs",
    "e2e:build": "node scripts/e2e-build.cjs",
    "db:seed": "dotenv -c -- prisma db seed",
    "db:seed:donation-funds": "dotenv -c -- tsx scripts/seed-donation-funds.ts",
    "legacy:import": "node scripts/run-import-legacy-data.mjs",
    "e2e": "cross-env IS_E2E=1 playwright test",
    "e2e:a11y": "cross-env IS_E2E=1 playwright test --project=a11y-chromium",
    "test:e2e": "run-s e2e:preflight e2e:build e2e",
    "test:e2e:a11y": "run-s e2e:preflight e2e:build e2e:a11y",
    "test-e2e": "npm run test:e2e",
    "pw:test": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -c -- prisma generate && dotenv -c -- prisma migrate deploy",
    "db:migrate:test": "node scripts/migrate-test-db.mjs",
    "db:migrate:dev": "dotenv -c -- prisma generate && dotenv -c -- prisma migrate dev",
    "db:studio": "dotenv -c -- prisma studio",
    "postinstall": "prisma generate && node scripts/playwright-postinstall.cjs",
    "email:dev": "email dev --dir emails",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "sync:prod-media": "node scripts/sync-prod-media.mjs",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@better-auth/i18n": "~1.7.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@foundernest/namecase": "^1.0.5",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.2",
    "@logtape/logtape": "^2.4.2",
    "@logtape/sentry": "^2.4.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-email/editor": "^1.7.22",
    "@sentry/nextjs": "^10.75.2",
    "@sentry/node": "^10.75.2",
    "@stripe/stripe-js": "9.17.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@zenstackhq/better-auth": "3.10.0",
    "@zenstackhq/orm": "3.10.0",
    "@zenstackhq/plugin-policy": "3.10.0",
    "@zenstackhq/server": "3.10.0",
    "@zenstackhq/zod": "3.10.0",
    "better-auth": "~1.7.18",
    "better-auth-audit-logs": "^0.4.0",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cron-parser": "5.10.3",
    "dotenv": "^17.4.2",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^0.577.0",
    "mysql2": "3.24.6",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "nodemailer": "^9.1.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "rate-limiter-flexible": "11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.5.0",
    "react-hook-form": "7.91.0",
    "resend": "^6.37.0",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/playwright": "^0.15.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "@faker-js/faker": "^10.4.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.4.1",
    "@playwright/test": "^1.65.0",
    "@react-email/ui": "6.11.7",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@swc/helpers": "^0.5.24",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.11",
    "@zenstackhq/cli": "3.10.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "7.15.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.0",
    "happy-dom": "20.14.6",
    "jsdom": "^29.1.1",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "0.25.0",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.3",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "ultracite": "7.12.4",
    "vite": "8.3.6",
    "vitest": "^4.1.11",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "@better-auth/core": "1.7.18",
    "@hono/node-server": "1.19.15",
    "@react-email/ui": {
      "next": "$next",
      "postcss": "$postcss"
    },
    "better-auth": "$better-auth",
    "brace-expansion": "5.0.9",
    "checkly": {
      "glob": "13.0.6"
    },
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.5",
    "handlebars": "4.7.10",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "kysely": "0.28.17",
    "lodash-es": "4.18.1",
    "next": {
      "postcss": "$postcss"
    },
    "npm": "11.19.0",
    "postcss": "$postcss",
    "proxy-addr": "2.0.8",
    "qs": "6.15.2",
    "resend": {
      "svix": "1.92.2"
    },
    "shell-quote": "1.11.0",
    "storybook": "10.6.6",
    "tinypool": "2.1.2",
    "uuid": "^14.0.0",
    "ws": "8.21.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "zenstack": {
    "schema": "zenstack/schema.zmodel"
  }
}
