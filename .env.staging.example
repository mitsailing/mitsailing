# Staging environment on the self-hosted Linux box (example.com).
# Copy this file to `.env.staging` on the server and fill in the real values.
# NEVER commit the filled file — staging secrets differ from prod.
#
# The deploy flow (.github/workflows/deploy.yml + bin/deploy.sh) reads this
# file via compose `env_file:` before bringing up the stack.

# ───── Runtime shape ─────
APP_ENV=staging

# Staging captures all outbound mail in the in-stack Mailpit container so QA
# can inspect verification, unlock, password-reset emails without real
# delivery. Flip to `resend` + set RESEND_API_KEY to send real mail.
MAIL_TRANSPORT=smtp

# ───── Better Auth ─────
# Generate a fresh secret for staging: `openssl rand -base64 32`. Do NOT
# share the production secret.
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Internal revalidation ─────
# Generate a fresh bearer token for staging newsletter archive cache refreshes.
NEWSLETTER_REVALIDATE_SECRET=replace-with-a-32+char-random-string-111111111

# ───── Health checks ─────
# Required for protected `/api/health/ready`; keep each secret value unique.
HEALTHCHECK_SECRET=replace-with-a-32+char-random-string-333333333

# ───── Public URL (served behind Cloudflare Tunnel) ─────
NEXT_PUBLIC_APP_URL=https://mitsailing.com

# ───── Database (in-stack postgres) ─────
# Host is the compose service name, not an IP — resolved via docker DNS.
DATABASE_URL=postgresql://postgres:CHANGE-ME-STRONG-PASSWORD@postgres:5432/app?sslmode=disable
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ───── Redis (BullMQ; Compose service `redis`) ─────
REDIS_URL=redis://redis:6379

# ───── Email (in-stack Mailpit) ─────
SMTP_URL=smtp://mailpit:1025
MAILPIT_API_URL=http://mailpit:8025
EMAIL_FROM="MIT Sailing (staging) <staging@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com
NEWSLETTER_WORKER_CONCURRENCY=2

# ───── CMS media uploads ─────
# CMS_MEDIA_ROOT must be an existing persistent mount owned by the app user
# and writable by that user. Compose mounts storage at this path.
CMS_MEDIA_ROOT=/var/lib/mitsailing/cms-media

# Mailpit UI basic-auth credentials. Generate the bcrypt hash once with:
#   docker run --rm httpd:alpine htpasswd -nbB mit 'YOUR-STRONG-PASSWORD'
# Paste the resulting `user:$2y$...` string (quote it in YAML contexts).
MAILPIT_UI_AUTH='mit:$2y$05$replaceWithRealBcryptHash..........................'

# ───── Cloudflare Tunnel ─────
# Create a named tunnel in Cloudflare Zero Trust, wire hostnames
# (mitsailing.com → http://app:3000), paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace-with-real-token

# ───── Resend (disabled on staging; present so `.env.staging` can be
# copied to `.env.production` and edited, never the other way around) ─────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ───── Stripe event payments ─────
# Use Stripe test-mode keys in staging. Prefer a restricted API key for
# STRIPE_SECRET_KEY with only the permissions this app needs.
STRIPE_SECRET_KEY=rk_test_replace_with_restricted_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_staging_webhook_secret

# ───── Observability ─────
NEXT_PUBLIC_LOGGING_LEVEL=info

# ───── Image ─────
# CI sets this per-deploy; pinned here as the default pulled by compose.
# `:staging` floats at the latest main commit; pin to a SHA for rollbacks.
APP_IMAGE=ghcr.io/mitsailing/mitsailing:staging
