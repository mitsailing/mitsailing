# Production data/media server environment. Copy to `.env.production.data` on
# the Docker data/media server and fill in real values. NEVER commit the filled
# file.

APP_ENV=production
MAIL_TRANSPORT=resend

# ───── Durable Docker data services ─────
POSTGRES_DB=mitsailing_prod
POSTGRES_USER=mitsailing
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD
DATABASE_URL=postgresql://mitsailing:CHANGE-ME-STRONG-PASSWORD@postgres:5432/mitsailing_prod?schema=public
REDIS_URL=redis://redis:6379

# ───── Shared media folder ─────
# Host bind mount root:
#   /srv/mitsailing-data/cms-media
MEDIA_STORAGE_ROOT=/srv/mitsailing-data/cms-media
MEDIA_UPLOAD_BASE_URL=https://uploads.mitsailing.com
MEDIA_PUBLIC_BASE_URL=https://media.mitsailing.com
MEDIA_UPLOAD_SHARED_SECRET=replace-with-a-32+char-random-string-555555555
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_UPLOAD_CORS_ALLOW_ORIGIN=https://mitsailing.com
# tusd calls this app route during pre-create to validate tokens and force the
# upload id to the CMS media asset UUID. Use the public app URL or a private
# load-balanced app ingress reachable from the data/media server.
TUSD_HOOKS_HTTP_URL=https://mitsailing.com/api/internal/cms-media/tusd/hooks
CMS_MEDIA_ROOT=/srv/mitsailing-data/cms-media

# ───── App secrets required by the worker image ─────
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000
HEALTHCHECK_SECRET=replace-with-a-32+char-random-string-333333333
NEXT_PUBLIC_APP_URL=https://mitsailing.com
NEXT_PUBLIC_LOGGING_LEVEL=info
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-32+char-random-string-111111111

# ───── Email and newsletter workers ─────
RESEND_API_KEY=re_replace_with_real_key
RESEND_WEBHOOK_SECRET=whsec_replace_with_real_secret
EMAIL_FROM="MIT Sailing <noreply@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com
NEWSLETTER_WORKER_CONCURRENCY=2

# ───── Legacy MySQL sync cron ─────
# Keep disabled until an operator intentionally enables it.
LEGACY_MYSQL_SYNC_ENABLED=false
LEGACY_MYSQL_SYNC_CRON="0 0 * * * *"
LEGACY_MYSQL_PASSWORD=
