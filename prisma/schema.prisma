// Better Auth canonical schema (PostgreSQL).
// See https://www.better-auth.com/docs/concepts/database for base tables and
// https://www.better-auth.com/docs/plugins/admin for admin plugin columns.
// The lockout table mirrors Devise's Lockable feature, driven by the hooks in
// src/libs/auth/hooks.ts. AuditLog backs the better-auth-audit-logs plugin.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK

  @@map("theme_preference")
}

model User {
  id               String          @id
  name             String
  email            String          @unique
  emailVerified    Boolean         @default(false) @map("email_verified")
  unconfirmedEmail String?         @map("unconfirmed_email")
  image            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  themePreference  ThemePreference @default(SYSTEM) @map("theme_preference")

  // Admin plugin columns.
  role       String    @default("user")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  sessions               Session[]
  accounts               Account[]
  auditLogs              AuditLog[]
  userAudits             UserAudit[]        @relation("UserAuditUser")
  impersonatedUserAudits UserAudit[]        @relation("UserAuditImpersonatedUser")
  siteTextOverrides      SiteTextOverride[]
  cmsMediaAssets         CmsMediaAsset[]    @relation("CmsMediaUploadedBy")

  eventRegistrations EventRegistration[]
  eventComments      EventComment[]
  eventAdmins        EventAdmin[]
  eventsCreated      Event[]              @relation("EventCreatedBy")
  sailingRatings     UserSailingRating[]  @relation("UserSailingRatings")
  issuedSailingRatings UserSailingRating[] @relation("IssuedSailingRatings")

  @@map("user")
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String   @map("user_id")
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// Lockout: Devise Lockable parity driven by src/libs/auth/hooks.ts.
model FailedLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("failed_login_attempts")
}

// Audit log: backs better-auth-audit-logs with Prisma persistence.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  status    String
  severity  String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

enum UserAuditAction {
  create
  update
  delete
  restore

  @@map("user_audit_action")
}

model UserAudit {
  id                 String          @id @default(cuid())
  auditableType      String          @map("auditable_type")
  auditableId        String          @map("auditable_id")
  userId             String?         @map("user_id")
  impersonatedUserId String?         @map("impersonated_user_id")
  action             UserAuditAction
  auditedChanges     Json            @map("audited_changes")
  version            Int
  comment            String?         @db.Text
  remoteAddress      String?         @map("remote_address")
  requestUuid        String?         @map("request_uuid")
  createdAt          DateTime        @default(now()) @map("created_at")

  user             User? @relation("UserAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  impersonatedUser User? @relation("UserAuditImpersonatedUser", fields: [impersonatedUserId], references: [id], onDelete: SetNull)

  @@unique([auditableType, auditableId, version])
  @@index([auditableType, auditableId, createdAt])
  @@index([userId])
  @@index([impersonatedUserId])
  @@index([action])
  @@map("user_audit")
}

model SiteTextOverride {
  id              String   @id @default(cuid())
  locale          String
  namespace       String
  key             String
  value           String   @db.Text
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([locale, namespace, key])
  @@index([locale])
  @@index([updatedByUserId])
  @@map("site_text_overrides")
}

// --- MIT Sailing domain (events, classes, fleet, about) ---

model EventCategory {
  id               String   @id
  name             String
  displayOrder     Int      @map("display_order")
  isVisible        Boolean  @map("is_visible")
  /** Tailwind `bg-*` utility for calendar/home category accent bar; null uses app default. */
  accentClassName  String?  @map("accent_class_name") @db.VarChar(128)
  createdAt        DateTime @map("created_at")
  events           Event[]

  @@map("event_categories")
}

enum EventDetailPageKind {
  standard
  external
}

model Event {
  id                String               @id
  name              String
  shortName         String               @map("short_name")
  eventCategoryId   String               @map("event_category_id")
  description       String               @db.Text
  slug              String               @unique
  isSpecial         Boolean              @map("is_special")
  maxParticipants   Int?                 @map("max_participants")
  requiresApproval  Boolean              @map("requires_approval")
  registrationStart DateTime?            @map("registration_start")
  registrationEnd   DateTime?            @map("registration_end")
  createdByUserId   String               @map("created_by")
  createdAt         DateTime             @map("created_at")
  detailPageKind    EventDetailPageKind? @map("detail_page_kind")
  externalDetailUrl String?              @map("external_detail_url")
  internalNotes     String?              @map("internal_notes") @db.Text
  isPublished       Boolean              @map("is_published")

  category                  EventCategory               @relation(fields: [eventCategoryId], references: [id], onDelete: Restrict)
  createdBy                 User                        @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  dates                     EventDate[]
  admins                    EventAdmin[]
  registrations             EventRegistration[]
  registrationQuestions     EventRegistrationQuestion[]
  entryFees                 EventEntryFee[]
  comments                  EventComment[]
  sailingClassRelatedEvents SailingClassRelatedEvent[]

  @@index([eventCategoryId])
  @@index([createdByUserId])
  @@map("events")
}

model EventDate {
  id            String   @id
  eventId       String   @map("event_id")
  startDateTime DateTime @map("start_datetime")
  endDateTime   DateTime @map("end_datetime")
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_dates")
}

model EventAdmin {
  id          String @id
  eventId     String @map("event_id")
  adminUserId String @map("admin_user_id")
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin       User   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([adminUserId])
  @@map("event_admins")
}

enum EventRegistrationStatus {
  pending
  approved
  cancelled
}

model EventRegistration {
  id                      String                    @id
  eventId                 String                    @map("event_id")
  userId                  String                    @map("user_id")
  status                  EventRegistrationStatus
  createdAt               DateTime                  @map("created_at")
  swimAgreementAcceptedAt DateTime                  @map("swim_agreement_accepted_at")
  event                   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationAnswers     EventRegistrationAnswer[]

  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

enum EventAnswerType {
  text
  select
  checkbox
}

model EventRegistrationQuestion {
  id           String                    @id
  eventId      String                    @map("event_id")
  questionText String                    @map("question_text") @db.Text
  answerType   EventAnswerType           @map("answer_type")
  options      Json? // string[] for select
  required     Boolean
  displayOrder Int                       @map("display_order")
  event        Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers      EventRegistrationAnswer[]

  @@index([eventId])
  @@map("event_registration_questions")
}

model EventRegistrationAnswer {
  id             String                    @id
  registrationId String                    @map("registration_id")
  questionId     String                    @map("question_id")
  value          String                    @db.Text
  registration   EventRegistration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question       EventRegistrationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([questionId])
  @@map("event_registration_answers")
}

/// Event registration fee line item. **`amount_cents`** stores **integer USD cents**
/// (e.g. `1999` for $19.99), matching Stripe `amount` for `currency: "usd"` and
/// avoiding floating-point dollar columns in PostgreSQL.
model EventEntryFee {
  id          String  @id
  eventId     String  @map("event_id")
  description String
  /// USD minor units (integer cents). Same domain as Stripe `amount`; never persist `19.99` here.
  amountCents Int     @map("amount_cents")
  isDeposit   Boolean @map("is_deposit")
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_entry_fees")
}

model EventComment {
  id        String         @id
  eventId   String         @map("event_id")
  parentId  String?        @map("parent_id")
  userId    String         @map("user_id")
  body      String         @db.Text
  createdAt DateTime       @map("created_at")
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    EventComment?  @relation("EventCommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  children  EventComment[] @relation("EventCommentThread")

  @@index([eventId])
  @@index([userId])
  @@index([parentId])
  @@map("event_comments")
}

model ClassCategory {
  id             String         @id
  slug           String         @unique
  name           String
  displayOrder   Int            @map("display_order")
  isVisible      Boolean        @map("is_visible")
  createdAt      DateTime       @map("created_at")
  sailingClasses SailingClass[]

  @@map("class_categories")
}

model SailingClass {
  id                  String                     @id
  name                String
  slug                String                     @unique
  classCategoryId     String                     @map("class_category_id")
  level               String
  description         String                     @db.Text
  imagePaths          String[]                   @default([]) @map("image_paths")
  displayOrder        Int                        @default(0) @map("display_order")
  isVisible           Boolean                    @default(true) @map("is_visible")
  classCategory       ClassCategory              @relation(fields: [classCategoryId], references: [id], onDelete: Restrict)
  fleetBoats          FleetBoat[]
  relatedEvents       SailingClassRelatedEvent[]
  prerequisiteEdges   SailingClassPrerequisite[] @relation("ClassRequiresPrerequisite")
  prerequisiteOfEdges SailingClassPrerequisite[] @relation("ClassIsPrerequisiteFor")
  unlockedBoatLinks   SailingClassUnlockedBoat[]
  ratingRules         SailingRatingRule[]

  @@index([classCategoryId])
  @@index([classCategoryId, displayOrder])
  @@index([isVisible])
  @@map("sailing_classes")
}

model SailingClassRelatedEvent {
  sailingClassId String       @map("sailing_class_id")
  eventId        String       @map("event_id")
  sailingClass   SailingClass @relation(fields: [sailingClassId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([sailingClassId, eventId])
  @@index([eventId])
  @@map("sailing_class_related_events")
}

model SailingClassPrerequisite {
  sailingClassId      String       @map("sailing_class_id")
  prerequisiteClassId String       @map("prerequisite_class_id")
  dependentClass      SailingClass @relation("ClassRequiresPrerequisite", fields: [sailingClassId], references: [id], onDelete: Cascade)
  prerequisiteClass   SailingClass @relation("ClassIsPrerequisiteFor", fields: [prerequisiteClassId], references: [id], onDelete: Restrict)

  @@id([sailingClassId, prerequisiteClassId])
  @@map("sailing_class_prerequisites")
}

model SailingClassUnlockedBoat {
  sailingClassId String       @map("sailing_class_id")
  fleetBoatId    String       @map("fleet_boat_id")
  sailingClass   SailingClass @relation(fields: [sailingClassId], references: [id], onDelete: Cascade)
  fleetBoat      FleetBoat    @relation(fields: [fleetBoatId], references: [id], onDelete: Restrict)

  @@id([sailingClassId, fleetBoatId])
  @@index([fleetBoatId])
  @@map("sailing_class_unlocked_boats")
}

model SailingRating {
  id           String   @id
  slug         String   @unique
  name         String
  shortName    String?  @map("short_name")
  description  String   @db.Text
  category     String?
  level        String?
  windCondition String?  @map("wind_condition")
  guideUrl     String?  @map("guide_url")
  displayOrder Int      @default(0) @map("display_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  isDeprecated Boolean  @default(false) @map("is_deprecated")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRatings UserSailingRating[]
  rules       SailingRatingRule[] @relation("RuleSailingRating")
  targetRules SailingRatingRule[] @relation("RuleTargetRating")

  @@index([isVisible, displayOrder])
  @@map("sailing_ratings")
}

model UserSailingRating {
  id              String   @id
  userId          String   @map("user_id")
  sailingRatingId String   @map("sailing_rating_id")
  issuedByUserId  String   @map("issued_by_user_id")
  issuedAt        DateTime @default(now()) @map("issued_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation("UserSailingRatings", fields: [userId], references: [id], onDelete: Cascade)
  sailingRating SailingRating @relation(fields: [sailingRatingId], references: [id], onDelete: Restrict)
  issuedBy      User          @relation("IssuedSailingRatings", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@unique([userId, sailingRatingId])
  @@index([userId])
  @@index([sailingRatingId])
  @@index([issuedByUserId])
  @@map("user_sailing_ratings")
}

enum SailingRatingRuleType {
  requires
  grants

  @@map("sailing_rating_rule_type")
}

model SailingRatingRule {
  id              String                @id
  boatId          String?               @map("boat_id")
  classId         String?               @map("class_id")
  ratingId        String?               @map("rating_id")
  ruleType        SailingRatingRuleType @map("rule_type")
  sailingRatingId String                @map("sailing_rating_id")
  groupKey        String                @default("default") @map("group_key")
  displayOrder    Int                   @default(0) @map("display_order")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  boat          FleetBoat?     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  sailingClass  SailingClass?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  targetRating  SailingRating? @relation("RuleTargetRating", fields: [ratingId], references: [id], onDelete: Cascade)
  sailingRating SailingRating  @relation("RuleSailingRating", fields: [sailingRatingId], references: [id], onDelete: Cascade)

  @@unique([boatId, ruleType, groupKey, sailingRatingId], map: "sailing_rating_rules_boat_uq")
  @@unique([classId, ruleType, groupKey, sailingRatingId], map: "sailing_rating_rules_class_uq")
  @@unique([ratingId, ruleType, groupKey, sailingRatingId], map: "sailing_rating_rules_rating_uq")
  @@index([boatId, ruleType])
  @@index([classId, ruleType])
  @@index([ratingId, ruleType])
  @@index([sailingRatingId])
  @@map("sailing_rating_rules")
}

model FleetBoat {
  id                String                     @id
  name              String
  slug              String                     @unique
  type              String
  capacity          Int
  displayOrder      Int                        @default(0) @map("display_order")
  requiredClassId   String                     @map("required_class_id")
  description       String                     @db.Text
  imagePath         String?                    @map("image_path")
  requiredClass     SailingClass               @relation(fields: [requiredClassId], references: [id], onDelete: Restrict)
  unlockedByClasses SailingClassUnlockedBoat[]
  ratingRules       SailingRatingRule[]

  @@index([requiredClassId])
  @@map("fleet_boats")
}

model SiteAlert {
  id          String   @id @default(cuid())
  body        String   @db.Text
  isPublished Boolean  @default(false) @map("is_published")
  startDate   DateTime @map("start_date") @db.Date
  lastDate    DateTime @map("last_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, startDate])
  @@map("site_alerts")
}

enum CmsBlockKind {
  hero
  text_section
  callout
  pricing
  home_overview
  home_classes

  @@map("cms_block_kind")
}

enum CmsMenuLocation {
  header
  mobile_utility
  footer
  legal
  social

  @@map("cms_menu_location")
}

model CmsPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  path            String   @unique
  title           String
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  blocks      CmsPageBlock[]
  menuItems   CmsMenuItem[]
  mediaAssets CmsMediaAsset[]

  @@index([isPublished, path])
  @@map("cms_pages")
}

model CmsPageBlock {
  id           String       @id @default(cuid())
  pageId       String       @map("page_id")
  kind         CmsBlockKind
  title        String
  subtitle     String?      @db.Text
  body         String?      @db.Text
  ctaLabel     String?      @map("cta_label")
  ctaUrl       String?      @map("cta_url")
  showCta      Boolean      @default(false) @map("show_cta")
  imageSrc     String?      @map("image_src")
  imageAlt     String?      @map("image_alt")
  showImage    Boolean      @default(false) @map("show_image")
  displayOrder Int          @default(0) @map("display_order")
  isVisible    Boolean      @default(true) @map("is_visible")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, displayOrder])
  @@map("cms_page_blocks")
}

model CmsMediaAsset {
  id               String   @id @default(cuid())
  pageId           String?  @map("page_id")
  storedFilename   String   @map("stored_filename")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  byteSize         Int      @map("byte_size")
  publicPath       String   @unique @map("public_path")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  page       CmsPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("CmsMediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([uploadedByUserId])
  @@map("cms_media_assets")
}

model CmsMenu {
  id        String          @id @default(cuid())
  location  CmsMenuLocation @unique
  title     String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  items CmsMenuItem[]

  @@map("cms_menus")
}

model CmsMenuItem {
  id           String   @id @default(cuid())
  menuId       String   @map("menu_id")
  parentId     String?  @map("parent_id")
  linkedPageId String?  @map("linked_page_id")
  label        String
  url          String?
  isExternal   Boolean  @default(false) @map("is_external")
  isVisible    Boolean  @default(true) @map("is_visible")
  displayOrder Int      @default(0) @map("display_order")
  systemKey    String?  @map("system_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  menu       CmsMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent     CmsMenuItem?  @relation("CmsMenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   CmsMenuItem[] @relation("CmsMenuItemChildren")
  linkedPage CmsPage?      @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)

  @@index([menuId, parentId, displayOrder])
  @@index([linkedPageId])
  @@map("cms_menu_items")
}

model DonationFund {
  id           String   @id @default(cuid())
  fundId       String   @unique @map("designation_id")
  name         String
  description  String   @db.Text
  url          String
  displayOrder Int      @default(0) @map("display_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isVisible, displayOrder])
  @@map("donation_funds")
}

model StaffMember {
  id       String  @id
  slug     String  @unique
  name     String
  role     String
  bio      String? @db.Text
  fullBio  Json
  imageSrc String? @map("image_src")
  imageAlt String? @map("image_alt")
  email    String

  @@map("staff_members")
}
