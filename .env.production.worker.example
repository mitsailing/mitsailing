# Worker-only legacy MySQL mirror secrets. Copy to `.env.production.worker`
# on the production host. Never commit the filled file.

# Master switch: false = no BullMQ scheduler and no sync jobs (leave false until
# MySQL connectivity is verified). Cron below is ignored when false.
LEGACY_MYSQL_SYNC_ENABLED=false
LEGACY_MYSQL_SYNC_CRON="0 0 * * * *"
LEGACY_MYSQL_PASSWORD=
# Connects as dock_readonly to sailing.pavilion.lan:3306 database sailing (fixed in app code).

# Worker processes validate the same production env as the web app. Keep these
# in sync with `.env.production` when the worker is launched from this file.
STRIPE_SECRET_KEY=rk_live_replace_with_restricted_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
