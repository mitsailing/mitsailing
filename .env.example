# Local development defaults. Copy to `.env` and tweak as needed. The live
# `.env` is git-ignored; only this `.example` template is committed.
#
# Philosophy: safe defaults for a dev laptop — no secrets, no prod infra.
# Local dev talks to the docker-compose stack (postgres + mailpit). Published
# host ports are configurable when something else already binds the defaults.

# ───── Runtime shape ─────
# APP_ENV names the deployment target (local/test/staging/production); it is
# orthogonal to NODE_ENV so staging can run a production build yet behave
# like staging (Mailpit instead of Resend, etc.).
APP_ENV=local

# Mail transport selector — enum, not boolean (scales cleanly to more
# providers). `smtp` drives nodemailer over SMTP_URL.
MAIL_TRANSPORT=smtp

# ───── Better Auth ─────
# Generate a strong secret for each env: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-32+char-random-string-000000000

# ───── Public app URL ─────
# Used by Better Auth for cookies + by the email senders to build absolute
# verification/unlock/reset URLs. Production images must bake this at `next build`
# (see deploy.yml build-arg); runtime `.env` alone cannot fix inlined client bundles.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───── Database ─────
# If 5432 is already in use locally, set POSTGRES_PUBLISH_PORT=5433 (example)
# and use that same port in DATABASE_URL / TEST_DATABASE_URL below. Compose
# reads POSTGRES_PUBLISH_PORT from this file when mapping the container.
POSTGRES_PUBLISH_PORT=5432
# docker-compose brings up both `dev_db` and `test_db` in one Postgres
# instance. Playwright/Vitest use TEST_DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dev_db?sslmode=disable
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/test_db?sslmode=disable

# ───── Redis (BullMQ — optional locally) ─────
# `docker compose` maps Redis to loopback; use for `npm run worker:dev`.
# REDIS_PUBLISH_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

# ───── Email (local Mailpit) ─────
# If 1025 or 8025 is already in use, set MAILPIT_SMTP_PUBLISH_PORT / MAILPIT_HTTP_PUBLISH_PORT
# and use the same numbers in SMTP_URL / MAILPIT_API_URL. Compose reads the *_PUBLISH_PORT vars.
MAILPIT_SMTP_PUBLISH_PORT=1025
MAILPIT_HTTP_PUBLISH_PORT=8025
# Dev/test pipe to Mailpit. MAILPIT_API_URL is read by the Playwright helper.
SMTP_URL=smtp://127.0.0.1:1025
MAILPIT_API_URL=http://127.0.0.1:8025
EMAIL_FROM="Your App <onboarding@mitsailing.com>"
SUPPORT_EMAIL=support@mitsailing.com

# Resend is production-only; keep blank locally so misconfiguration cannot
# accidentally ship dev mail through production infrastructure.
RESEND_API_KEY=

# ───── Observability (optional) ─────
NEXT_PUBLIC_LOGGING_LEVEL=debug
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — paste DSN from Sentry → project → Client Keys (DSN). Never commit a
# filled value; keep secrets in `.env` only. `next build` source-map upload
# uses SENTRY_AUTH_TOKEN (see https://docs.sentry.io/platforms/javascript/guides/nextjs/sourcemaps/).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# Set to disable SDK + webpack plugin (matches CI / Docker PR builds):
# NEXT_PUBLIC_SENTRY_DISABLED=1

# ───── Bot detection (optional) ─────
# ARCJET_KEY=ajkey_...

# ───── Misc ─────
NEXT_TELEMETRY_DISABLED=1

# ───── Admin bootstrap (`npm run db:seed`) ─────
# Seed upserts this user with role admin + Better Auth credential login.
# Change both values below before `npm run db:seed` if you are not the only
# person who can hit localhost:3000, or use your own email + strong password
# from day one. Never ship these defaults to staging/production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-local-change-me
