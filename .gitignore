.vitest-attachments/

# next.js
/.next/
/out/

# production
/build
/worker.cjs
/worker.mjs
/.deploy/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE secrets (e.g. sourcery.token) — keep in Cursor User settings, not committed
.vscode/settings.local.json

# local env files — committed only when suffixed `.example`
.env
.env.*
!.env.example
!.env.*.example

# Sentry Config File
.env.sentry-build-plugin

# local folder
local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database
*.db

# Prisma 7 — generated client (see `postinstall`: `prisma generate`)
/src/generated/

# storybook
storybook-static
*storybook.log
build-archive.log

# playwright
/test-results/
/playwright-report/
/blob-report/
